<?xml version="1.0" encoding="utf-8"?>
<!-- 手机/平板播放器控制条底衬：上深下浅的深色渐变，保证白色图标在任何画面上都可读 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#E60A1830"
        android:centerColor="#990A1830"
        android:endColor="#000A1830" />
    <corners android:radius="14dp" />
</shape>
